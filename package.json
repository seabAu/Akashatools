{
  "name": "akashatools",
  "version": "2.0.0-alpha.1",
  "description": "Dependency-free JavaScript utilities for arrays, objects, strings, numbers, dates, validation, async workflows, and browser tasks.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./array": "./src/array.js",
    "./async": "./src/async.js",
    "./browser": "./src/browser.js",
    "./collection": "./src/collection.js",
    "./date": "./src/date.js",
    "./number": "./src/number.js",
    "./object": "./src/object.js",
    "./random": "./src/random.js",
    "./sort": "./src/sort.js",
    "./string": "./src/string.js",
    "./validation": "./src/validation.js",
    "./lib": "./lib/index.js",
    "./lib/index.js": "./lib/index.js",
    "./lib/*.js": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --run check:syntax && node --run test",
    "check:syntax": "node --check src/index.js && node --check lib/index.js",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seabAu/Akashatools.git"
  },
  "bugs": {
    "url": "https://github.com/seabAu/Akashatools/issues"
  },
  "homepage": "https://github.com/seabAu/Akashatools#readme",
  "keywords": [
    "utilities",
    "javascript",
    "tree-shaking",
    "arrays",
    "objects"
  ],
  "author": "Sean Brown",
  "license": "ISC"
}
