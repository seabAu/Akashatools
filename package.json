{
  "name": "akashatools",
  "version": "2.0.0-alpha.1",
  "description": "Dependency-free JavaScript utilities for shared, browser, and Node.js application code.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./array": {
      "types": "./types/array/index.d.ts",
      "import": "./src/array/index.js",
      "default": "./src/array/index.js"
    },
    "./array/*": {
      "types": "./types/array/*.d.ts",
      "import": "./src/array/*.js",
      "default": "./src/array/*.js"
    },
    "./async": {
      "types": "./types/async/index.d.ts",
      "import": "./src/async/index.js",
      "default": "./src/async/index.js"
    },
    "./async/*": {
      "types": "./types/async/*.d.ts",
      "import": "./src/async/*.js",
      "default": "./src/async/*.js"
    },
    "./browser": {
      "types": "./types/browser/index.d.ts",
      "browser": "./src/browser/index.js",
      "import": "./src/browser/index.js",
      "default": "./src/browser/index.js"
    },
    "./browser/*": {
      "types": "./types/browser/*.d.ts",
      "browser": "./src/browser/*.js",
      "import": "./src/browser/*.js",
      "default": "./src/browser/*.js"
    },
    "./collection": {
      "types": "./types/collection/index.d.ts",
      "import": "./src/collection/index.js",
      "default": "./src/collection/index.js"
    },
    "./collection/*": {
      "types": "./types/collection/*.d.ts",
      "import": "./src/collection/*.js",
      "default": "./src/collection/*.js"
    },
    "./data": {
      "types": "./types/data/index.d.ts",
      "import": "./src/data/index.js",
      "default": "./src/data/index.js"
    },
    "./data/*": {
      "types": "./types/data/*.d.ts",
      "import": "./src/data/*.js",
      "default": "./src/data/*.js"
    },
    "./date": {
      "types": "./types/date/index.d.ts",
      "import": "./src/date/index.js",
      "default": "./src/date/index.js"
    },
    "./date/*": {
      "types": "./types/date/*.d.ts",
      "import": "./src/date/*.js",
      "default": "./src/date/*.js"
    },
    "./http": {
      "types": "./types/http/index.d.ts",
      "import": "./src/http/index.js",
      "default": "./src/http/index.js"
    },
    "./http/*": {
      "types": "./types/http/*.d.ts",
      "import": "./src/http/*.js",
      "default": "./src/http/*.js"
    },
    "./hash": {
      "types": "./types/hash/index.d.ts",
      "import": "./src/hash/index.js",
      "default": "./src/hash/index.js"
    },
    "./hash/*": {
      "types": "./types/hash/*.d.ts",
      "import": "./src/hash/*.js",
      "default": "./src/hash/*.js"
    },
    "./geo": {
      "types": "./types/geo/index.d.ts",
      "import": "./src/geo/index.js",
      "default": "./src/geo/index.js"
    },
    "./geo/*": {
      "types": "./types/geo/*.d.ts",
      "import": "./src/geo/*.js",
      "default": "./src/geo/*.js"
    },
    "./input": {
      "types": "./types/input/index.d.ts",
      "import": "./src/input/index.js",
      "default": "./src/input/index.js"
    },
    "./input/*": {
      "types": "./types/input/*.d.ts",
      "import": "./src/input/*.js",
      "default": "./src/input/*.js"
    },
    "./function": {
      "types": "./types/function/index.d.ts",
      "import": "./src/function/index.js",
      "default": "./src/function/index.js"
    },
    "./function/*": {
      "types": "./types/function/*.d.ts",
      "import": "./src/function/*.js",
      "default": "./src/function/*.js"
    },
    "./node": {
      "types": "./types/node/index.d.ts",
      "node": "./src/node/index.js",
      "import": "./src/node/index.js",
      "default": "./src/node/index.js"
    },
    "./node/*": {
      "types": "./types/node/*.d.ts",
      "node": "./src/node/*.js",
      "import": "./src/node/*.js",
      "default": "./src/node/*.js"
    },
    "./number": {
      "types": "./types/number/index.d.ts",
      "import": "./src/number/index.js",
      "default": "./src/number/index.js"
    },
    "./number/*": {
      "types": "./types/number/*.d.ts",
      "import": "./src/number/*.js",
      "default": "./src/number/*.js"
    },
    "./object": {
      "types": "./types/object/index.d.ts",
      "import": "./src/object/index.js",
      "default": "./src/object/index.js"
    },
    "./object/*": {
      "types": "./types/object/*.d.ts",
      "import": "./src/object/*.js",
      "default": "./src/object/*.js"
    },
    "./random": {
      "types": "./types/random/index.d.ts",
      "import": "./src/random/index.js",
      "default": "./src/random/index.js"
    },
    "./random/*": {
      "types": "./types/random/*.d.ts",
      "import": "./src/random/*.js",
      "default": "./src/random/*.js"
    },
    "./sort": {
      "types": "./types/sort/index.d.ts",
      "import": "./src/sort/index.js",
      "default": "./src/sort/index.js"
    },
    "./sort/*": {
      "types": "./types/sort/*.d.ts",
      "import": "./src/sort/*.js",
      "default": "./src/sort/*.js"
    },
    "./string": {
      "types": "./types/string/index.d.ts",
      "import": "./src/string/index.js",
      "default": "./src/string/index.js"
    },
    "./string/*": {
      "types": "./types/string/*.d.ts",
      "import": "./src/string/*.js",
      "default": "./src/string/*.js"
    },
    "./validation": {
      "types": "./types/validation/index.d.ts",
      "import": "./src/validation/index.js",
      "default": "./src/validation/index.js"
    },
    "./validation/*": {
      "types": "./types/validation/*.d.ts",
      "import": "./src/validation/*.js",
      "default": "./src/validation/*.js"
    },
    "./lib": "./lib/index.js",
    "./lib/index.js": "./lib/index.js",
    "./lib/*.js": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "benchmark",
    "src",
    "lib",
    "types",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "benchmark": "node --run benchmark:membership && node --run benchmark:collator && node --run benchmark:text && node --run benchmark:excepted && node --run benchmark:type-vocabulary",
    "benchmark:collator": "node benchmark/collator.mjs",
    "benchmark:membership": "node benchmark/membership.mjs",
    "benchmark:excepted": "node benchmark/excepted-modules.mjs",
    "benchmark:text": "node benchmark/text-measurement.mjs",
    "benchmark:type-vocabulary": "node benchmark/type-vocabulary.mjs",
    "bundle:check": "node scripts/measure-bundles.mjs && node scripts/measure-consumer-bundles.mjs",
    "bundle:consumers": "node scripts/measure-consumer-bundles.mjs",
    "format": "prettier --write \"{src,test,browser-test,scripts,benchmark,fixtures}/**/*.{js,mjs}\" \".github/**/*.{yml,yaml}\" \"*.config.js\" package.json jsconfig.json tsconfig.types.json",
    "format:check": "prettier --check \"{src,test,browser-test,scripts,benchmark,fixtures}/**/*.{js,mjs}\" \".github/**/*.{yml,yaml}\" \"*.config.js\" package.json jsconfig.json tsconfig.types.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:release": "npm run audit:dependencies && npm run check && npm run test:coverage && npm run pack:check",
    "check": "node --run check:syntax && node --run check:hygiene && node --run lint && node --run format:check && node --run check:docs && node --run check:generated && node --run check:types && node --run test:types && node --run test:completions && node --run bundle:check && node --run test:package && node --run test",
    "check:docs": "node scripts/check-api-docs.mjs",
    "check:generated": "node scripts/generate-entrypoints.mjs --check && node scripts/generate-api-reference.mjs --check && node scripts/generate-migration-index.mjs --check && node scripts/generate-api-snapshot.mjs --check",
    "check:hygiene": "node scripts/check-release-hygiene.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "entrypoints": "node scripts/generate-entrypoints.mjs",
    "docs:migration": "node scripts/generate-migration-index.mjs",
    "api:snapshot": "node scripts/generate-api-snapshot.mjs",
    "types:build": "node scripts/build-types.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check:types": "npm run typecheck && node scripts/build-types.mjs --check",
    "test:types": "tsc -p fixtures/types/tsconfig.json",
    "test:completions": "node scripts/check-editor-completions.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test": "node --test",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium firefox webkit",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seabAu/Akashatools.git"
  },
  "bugs": {
    "url": "https://github.com/seabAu/Akashatools/issues"
  },
  "homepage": "https://github.com/seabAu/Akashatools#readme",
  "keywords": [
    "utilities",
    "javascript",
    "tree-shaking",
    "arrays",
    "objects"
  ],
  "author": "Sean Brown",
  "license": "ISC",
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "@types/punycode": "2.1.4",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "^7.0.2"
  }
}
