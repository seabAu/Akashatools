{
  "name": "akashatools",
  "version": "2.0.0-alpha.1",
  "description": "Dependency-free JavaScript utilities for shared, browser, and Node.js application code.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": { "types": "./types/index.d.ts", "import": "./src/index.js", "default": "./src/index.js" },
    "./array": { "types": "./types/array.d.ts", "import": "./src/array.js", "default": "./src/array.js" },
    "./async": { "types": "./types/async.d.ts", "import": "./src/async.js", "default": "./src/async.js" },
    "./browser": { "types": "./types/browser.d.ts", "browser": "./src/browser.js", "import": "./src/browser.js", "default": "./src/browser.js" },
    "./collection": { "types": "./types/collection.d.ts", "import": "./src/collection.js", "default": "./src/collection.js" },
    "./date": { "types": "./types/date.d.ts", "import": "./src/date.js", "default": "./src/date.js" },
    "./http": { "types": "./types/http.d.ts", "import": "./src/http.js", "default": "./src/http.js" },
    "./node": { "types": "./types/node.d.ts", "node": "./src/node.js", "import": "./src/node.js", "default": "./src/node.js" },
    "./number": { "types": "./types/number.d.ts", "import": "./src/number.js", "default": "./src/number.js" },
    "./object": { "types": "./types/object.d.ts", "import": "./src/object.js", "default": "./src/object.js" },
    "./random": { "types": "./types/random.d.ts", "import": "./src/random.js", "default": "./src/random.js" },
    "./sort": { "types": "./types/sort.d.ts", "import": "./src/sort.js", "default": "./src/sort.js" },
    "./string": { "types": "./types/string.d.ts", "import": "./src/string.js", "default": "./src/string.js" },
    "./validation": { "types": "./types/validation.d.ts", "import": "./src/validation.js", "default": "./src/validation.js" },
    "./lib": "./lib/index.js",
    "./lib/index.js": "./lib/index.js",
    "./lib/*.js": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "benchmark",
    "src",
    "lib",
    "types",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark:collator": "node benchmark/collator.mjs",
    "benchmark:membership": "node benchmark/membership.mjs",
    "check": "node --run check:syntax && node --run check:docs && node --run check:generated && node --run check:types && node --run test:types && node --run test:completions && node --run test",
    "check:docs": "node scripts/check-api-docs.mjs",
    "check:generated": "node scripts/generate-api-reference.mjs --check && node scripts/generate-migration-index.mjs --check && node scripts/generate-api-snapshot.mjs --check",
    "check:syntax": "node --check src/index.js && node --check src/node.js && node --check src/internal/contained-path.js && node --check lib/index.js",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "docs:migration": "node scripts/generate-migration-index.mjs",
    "api:snapshot": "node scripts/generate-api-snapshot.mjs",
    "types:build": "node scripts/build-types.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check:types": "npm run typecheck && node scripts/build-types.mjs --check",
    "test:types": "tsc -p fixtures/types/tsconfig.json",
    "test:completions": "node scripts/check-editor-completions.mjs",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seabAu/Akashatools.git"
  },
  "bugs": {
    "url": "https://github.com/seabAu/Akashatools/issues"
  },
  "homepage": "https://github.com/seabAu/Akashatools#readme",
  "keywords": [
    "utilities",
    "javascript",
    "tree-shaking",
    "arrays",
    "objects"
  ],
  "author": "Sean Brown",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
